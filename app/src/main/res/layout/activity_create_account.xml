<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <ScrollView
        android:id="@+id/scrollViewCreateAccount"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <!-- App Logo Image -->
            <ImageView
                android:id="@+id/ivLogo"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="12dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_student_portal" />

            <!-- Student Learning Portal Title -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/ivLogo"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/title_student_learning_portal"
                android:textColor="@color/primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Subtitle -->
            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvTitle"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:text="@string/title_create_account"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />

            <!-- Full Name Input -->
            <EditText
                android:id="@+id/etFullName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvSubtitle"
                android:layout_marginTop="8dp"
                android:background="@drawable/edit_text_bg"
                android:hint="@string/hint_full_name"
                android:importantForAutofill="no"
                android:inputType="textPersonName|textCapWords"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="15sp" />

            <!-- Student ID Input -->
            <EditText
                android:id="@+id/etStudentId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/etFullName"
                android:layout_marginTop="12dp"
                android:background="@drawable/edit_text_bg"
                android:hint="@string/hint_student_id"
                android:importantForAutofill="no"
                android:inputType="text"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="15sp" />

            <!-- Email Address Input -->
            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/etStudentId"
                android:layout_marginTop="12dp"
                android:background="@drawable/edit_text_bg"
                android:hint="@string/hint_email"
                android:importantForAutofill="no"
                android:inputType="textEmailAddress"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="15sp" />

            <!-- Password Input -->
            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/etEmail"
                android:layout_marginTop="12dp"
                android:background="@drawable/edit_text_bg"
                android:hint="@string/hint_password"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="15sp" />

            <!-- Confirm Password Input -->
            <EditText
                android:id="@+id/etConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/etPassword"
                android:layout_marginTop="12dp"
                android:background="@drawable/edit_text_bg"
                android:hint="@string/hint_confirm_password"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="15sp" />

            <!-- Department Label -->
            <TextView
                android:id="@+id/tvDepartmentLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/etConfirmPassword"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="4dp"
                android:text="@string/label_department"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Department Spinner Dropdown -->
            <Spinner
                android:id="@+id/spinnerDepartment"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_below="@id/tvDepartmentLabel"
                android:background="@drawable/spinner_bg"
                android:entries="@array/departments_array"
                android:spinnerMode="dropdown" />

            <!-- Semester Label -->
            <TextView
                android:id="@+id/tvSemesterLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/spinnerDepartment"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="4dp"
                android:text="@string/label_semester"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Semester Spinner Dropdown -->
            <Spinner
                android:id="@+id/spinnerSemester"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_below="@id/tvSemesterLabel"
                android:background="@drawable/spinner_bg"
                android:entries="@array/semesters_array"
                android:spinnerMode="dropdown" />

            <!-- Date of Admission Label -->
            <TextView
                android:id="@+id/tvDateLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/spinnerSemester"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="4dp"
                android:text="@string/label_date_of_admission"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Date of Admission Field (Click opens Calendar DatePickerDialog) -->
            <EditText
                android:id="@+id/etDateOfAdmission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvDateLabel"
                android:background="@drawable/edit_text_bg"
                android:clickable="true"
                android:cursorVisible="false"
                android:drawableEnd="@drawable/ic_calendar"
                android:drawablePadding="10dp"
                android:focusable="false"
                android:hint="@string/hint_date_of_admission"
                android:importantForAutofill="no"
                android:inputType="none"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="15sp" />

            <!-- Create Account Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCreateAccount"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_below="@id/etDateOfAdmission"
                android:layout_marginTop="22dp"
                android:background="@drawable/button_primary_bg"
                android:fontFamily="sans-serif-medium"
                android:text="@string/btn_create_account"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <!-- Already have an account? Login -->
            <TextView
                android:id="@+id/tvAlreadyAccount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/btnCreateAccount"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="24dp"
                android:padding="8dp"
                android:text="@string/link_already_have_account"
                android:textColor="@color/secondary"
                android:textSize="14sp" />

        </RelativeLayout>
    </ScrollView>
</RelativeLayout>
